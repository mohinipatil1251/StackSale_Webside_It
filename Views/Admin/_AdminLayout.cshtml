<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - Admin Panel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                background: #f4f7fc;
                font-family: Arial, Helvetica, sans-serif;
            }

            .sidebar {
                position: fixed;
                left: 0;
                top: 0;
                width: 250px;
                height: 100vh;
                background: #0b1f8f;
            }

            .logo {
                color: white;
                text-align: center;
                font-size: 28px;
                font-weight: bold;
                padding: 30px 0;
                border-bottom: 1px solid rgba(255,255,255,.2);
            }

            .sidebar a {
                display: block;
                color: white;
                text-decoration: none;
                padding: 18px 25px;
                font-size: 17px;
                transition: .3s;
            }

                .sidebar a:hover {
                    background: #1b38d1;
                }

            .main-content {
                margin-left: 250px;
            }

            .topbar {
                background: white;
                padding: 20px 30px;
                box-shadow: 0 3px 8px rgba(0,0,0,.08);
            }

            .page-content {
                padding: 30px;
            }

    </style>

</head>

<body>

    <!-- Sidebar -->

    <div class="sidebar">

        <div class="logo">

            StackSale

        </div>

        <a asp-controller="Admin"
           asp-action="Dashboard">

            🏠 Dashboard

        </a>

        <a asp-controller="Admin"
           asp-action="ContactMessages">

            📩 Contact Messages

        </a>

        <a asp-controller="Service"
           asp-action="AdminIndex">

            💻 Manage Services

        </a>

        <a asp-controller="Home"
           asp-action="Index">

            🌐 Open Website

        </a>

        <a asp-controller="Admin"
           asp-action="Login">

            🚪 Logout

        </a>

    </div>

    <!-- Main Content -->

    <div class="main-content">

        <div class="topbar">

            <h3>Welcome Admin 👋</h3>

        </div>

        <div class="page-content">

            @RenderBody()

        </div>
        @await RenderSectionAsync("Scripts", required: false)
    </div>

</body>
</html>