@model IEnumerable<IT_Company_web.Models.ContactMessage>
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewData["Title"] = "Contact Messages";
}

<div class="container mt-5">

    <h2>Contact Messages</h2>

    <hr />

    <table class="table table-bordered table-striped">

        <thead class="table-dark">

            <tr>
                <th>Id</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Subject</th>
                <th>Message</th>
                <th>Date</th>
            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.Id</td>

                    <td>@item.FullName</td>

                    <td>@item.Email</td>

                    <td>@item.Phone</td>

                    <td>@item.Subject</td>

                    <td>@item.Message</td>

                    <td>@item.CreatedDate.ToString("dd-MM-yyyy")</td>

                </tr>
            }

        </tbody>

    </table>

</div>