@model IT_Company_web.Models.ContactMessage

@{
    ViewData["Title"] = "Contact";
}

<div class="page-title">
    <h1>Contact Us</h1>
    <p>We'd Love to Hear From You</p>
</div>

<section class="contact-section">

    <div class="container">

        <div class="row g-4">

            <!-- Company Details -->
            <div class="col-lg-5">

                <div class="company-card">

                    <h2>Get In Touch</h2>

                    <p>
                        We provide software solutions,
                        websites, mobile applications
                        and cloud services.
                    </p>

                    <div class="info-box">
                        <h5>📍 Address</h5>
                        <p>Pune, Maharashtra, India</p>
                    </div>

                    <div class="info-box">
                        <h5>📞 Phone</h5>
                        <p>+91 9876543210</p>
                    </div>

                    <div class="info-box">
                        <h5>📧 Email</h5>
                        <p>info@xybimeta.com</p>
                    </div>

                    <div class="info-box">
                        <h5>🌐 Website</h5>
                        <p>www.xybimeta.com</p>
                    </div>

                    <div class="info-box">
                        <h5>🕒 Office Hours</h5>
                        <p>Mon - Sat : 9 AM - 7 PM</p>
                    </div>

                </div>

            </div>

            <!-- Contact Form -->
            <div class="col-lg-7">

                <div class="contact-card">

                    <h2>Send Message</h2>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["Success"]
                        </div>
                    }

                    <form asp-action="Contact" asp-controller="Home" method="post">

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <input asp-for="FullName" class="form-control" placeholder="Full Name" />
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <input asp-for="Email" class="form-control" placeholder="Email Address" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <input asp-for="Phone" class="form-control" placeholder="Phone Number" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <input asp-for="Subject" class="form-control" placeholder="Subject" />
                                <span asp-validation-for="Subject" class="text-danger"></span>
                            </div>

                            <div class="col-12 mb-3">
                                <textarea asp-for="Message"
                                          class="form-control"
                                          rows="6"
                                          placeholder="Write Your Message"></textarea>
                                <span asp-validation-for="Message" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <button type="submit" class="send-btn">
                                    Send Message
                                </button>
                            </div>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>

<section class="map-section">

    <div class="map-card">

        <h2>Our Location</h2>

        <iframe src="https://www.google.com/maps?q=Pune&output=embed"
                width="100%"
                height="350"
                style="border:0;"
                loading="lazy">
        </iframe>

    </div>

</section>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
