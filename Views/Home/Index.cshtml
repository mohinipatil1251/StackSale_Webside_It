@{
    ViewData["Title"] = "Home";
}

<section class="hero">

    <!-- Left Logo -->
    <div class="hero-logo">

        <div class="logo-circle">
            <img src="~/Image/StackSale logo.jpeg" alt="StackSale Logo" />
        </div>

    </div>

    <!-- Center Content -->
    <div class="hero-content">

        <h1>
            Welcome to <span class="yellow">StackSale</span>
        </h1>

        <div class="line"></div>

        <h3>Build Smart Digital Solutions for Modern Businesses</h3>

        <p>
            StackSale is a modern IT company delivering innovative
            software solutions for startups, businesses, and enterprises.
            We build secure, scalable, and high-performance digital
            products that help businesses grow with the latest technology.
        </p>

        <div class="hero-features">

            <span>✔ Web Development</span>
            <span>✔ Mobile Apps</span>
            <span>✔ Cloud Solutions</span>
            <span>✔ AI Solutions</span>

        </div>

        <div class="hero-buttons">

            <a asp-controller="Service"
               asp-action="Index"
               class="hero-btn">
                Explore Services
            </a>

            <a asp-controller="Home"
               asp-action="Contact"
               class="hero-btn hero-btn-outline">
                Contact Us
            </a>

        </div>

    </div>

    <!-- Right Image -->

    <div class="hero-image">

        <img src="~/Image/image2.jpg" alt="Laptop" />

    </div>

</section>


<section class="about-box">

    <h2>Who We Are</h2>

    <div class="small-line"></div>

    <p>

        <strong>StackSale</strong> is a modern IT company providing innovative
        software solutions for startups, businesses, and enterprises.

        We specialize in Web Development,
        Mobile Applications,
        Cloud Computing,
        Artificial Intelligence,
        UI/UX Design,
        and Enterprise Software.

    </p>

</section>