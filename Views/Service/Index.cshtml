@model IEnumerable<IT_Company_web.Models.Service>

@{
    ViewData["Title"] = "Services";
}

<div class="page-title">
    <h1>Our Services</h1>
    <p>Innovative IT Solutions for Your Business Growth</p>
</div>

<section class="services-section">

    <div class="cards">

        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="card">

                    @if (!string.IsNullOrEmpty(item.Image))
                    {
                        <img src="~/Image/@item.Image"
                             class="img-fluid rounded mb-3"
                             style="width:100%; height:200px; object-fit:cover;" />
                    }

                    <h3>@item.ServiceName</h3>

                    <p>@item.Description</p>

                </div>
            }
        }
        else
        {
            <div class="card">

                <h3>No Services Available</h3>

                <p>
                    Services will appear here after adding them from the Admin Panel.
                </p>

            </div>
        }

    </div>

</section>

<!-- WHY CHOOSE SECTION -->

<section class="why-section">

    <div class="why-container">

        <h2>Why Choose StackSale?</h2>

        <ul>
            <li>✔ Experienced Development Team</li>
            <li>✔ High Quality Software</li>
            <li>✔ On-Time Project Delivery</li>
            <li>✔ Affordable Pricing</li>
            <li>✔ 24/7 Technical Support</li>
            <li>✔ Modern Technologies</li>
        </ul>

    </div>

</section>