@model IEnumerable<IT_Company_web.Models.Career>

@{
    ViewData["Title"] = "Careers";
}

<div class="page-title">
    <h1>Careers</h1>
    <p>Join Our Growing Team</p>
</div>

<section>

    <div class="career-heading">
        <h2>Current Openings</h2>
    </div>

    <div class="cards">

        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="card">

                    <h3>@item.JobTitle</h3>

                    <p><strong>Experience :</strong> @item.Experience</p>

                    <p><strong>Location :</strong> @item.Location</p>

                    <p><strong>Salary :</strong> @item.Salary</p>

                    <p>@item.Description</p>

                    <a asp-controller="Careers"
                       asp-action="Apply"
                       asp-route-id="@item.Id"
                       class="btn btn-primary">

                        Apply Now

                    </a>

                </div>
            }
        }
        else
        {
            <div class="card">

                <h3>No Jobs Available</h3>

                <p>Please check again later.</p>

            </div>
        }

    </div>

</section>

<section>

    <div class="career-heading">
        <h2>Why Join Us?</h2>
    </div>

    <ul>
        <li>✔ Friendly Work Environment</li>
        <li>✔ Career Growth Opportunities</li>
        <li>✔ Flexible Working Hours</li>
        <li>✔ Competitive Salary</li>
        <li>✔ Learning & Development</li>
    </ul>

</section>