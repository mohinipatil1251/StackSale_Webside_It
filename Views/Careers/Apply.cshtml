@model IT_Company_web.Models.JobApplication

@{
    ViewData["Title"] = "Apply Job";
    var job = ViewBag.Career as IT_Company_web.Models.Career;
}

<div class="container mt-5">

    <div class="row">

        <!-- LEFT SIDE -->

        <div class="col-lg-5">

            <div class="card shadow-lg border-0">

                <div class="card-header bg-primary text-white">

                    <h3>@job.JobTitle</h3>

                </div>

                <div class="card-body">

                    <p><b>📍 Location :</b> @job.Location</p>

                    <p><b>💰 Salary :</b> @job.Salary</p>

                    <p><b>🕒 Experience :</b> @job.Experience</p>

                    <hr />

                    <h5>📋 Job Description</h5>

                    <p>@job.Description</p>

                    <hr />

                    <h5>💻 Required Skills</h5>

                    @if(job.JobTitle=="Frontend Developer")
                    {
                        <ul>
                            <li>✔ HTML5</li>
                            <li>✔ CSS3</li>
                            <li>✔ Bootstrap</li>
                            <li>✔ JavaScript</li>
                            <li>✔ React</li>
                            <li>✔ Git</li>
                            <li>✔ REST API</li>
                        </ul>
                    }
                    else if(job.JobTitle=="Backend Developer")
                    {
                        <ul>
                            <li>✔ ASP.NET Core</li>
                            <li>✔ C#</li>
                            <li>✔ Entity Framework</li>
                            <li>✔ SQL Server</li>
                            <li>✔ LINQ</li>
                            <li>✔ REST API</li>
                        </ul>
                    }
                    else
                    {
                        <ul>
                            <li>✔ Communication</li>
                            <li>✔ Team Work</li>
                            <li>✔ Problem Solving</li>
                        </ul>
                    }

                    <hr />

                    <h5>🎯 Responsibilities</h5>

                    <ul>
                        <li>Develop Quality Software</li>
                        <li>Work with Team</li>
                        <li>Write Clean Code</li>
                        <li>Fix Bugs</li>
                        <li>Participate in Meetings</li>
                    </ul>

                </div>

            </div>

        </div>

        <!-- RIGHT SIDE -->

        <div class="col-lg-7">

            <div class="card shadow-lg border-0">

                <div class="card-header bg-success text-white">

                    <h3>Application Form</h3>

                </div>

                <div class="card-body">

                    <form asp-action="Apply"
                          method="post"
                          enctype="multipart/form-data">

                        <input asp-for="CareerId" type="hidden"/>

                        <div asp-validation-summary="All"
                             class="text-danger">
                        </div>

                        <div class="mb-3">
                            <label asp-for="CandidateName" class="form-label"></label>
                            <input asp-for="CandidateName" class="form-control" />
                            <span asp-validation-for="CandidateName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Role</label>

                            <select asp-for="Role" class="form-select">
                                <option value="">Select Role</option>
                                <option>Frontend Developer</option>
                                <option>Backend Developer</option>
                                <option>Full Stack Developer</option>
                                <option>UI/UX Designer</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Technology</label>

                            <select asp-for="Technology" class="form-select">
                                <option value="">Select Technology</option>

                                @if (job.JobTitle == "Frontend Developer")
                                {
                                    <option>HTML</option>
                                    <option>CSS</option>
                                    <option>Bootstrap</option>
                                    <option>JavaScript</option>
                                    <option>React</option>
                                }
                                else if (job.JobTitle == "Backend Developer")
                                {
                                    <option>ASP.NET Core</option>
                                    <option>C#</option>
                                    <option>Entity Framework</option>
                                    <option>SQL Server</option>
                                    <option>Web API</option>
                                }
                                else
                                {
                                    <option>Other</option>
                                }

                            </select>
                        </div>

                        <div class="mb-3">

                            <label class="form-label">Experience</label>

                            <select asp-for="Experience" class="form-select">

                                <option>Fresher</option>
                                <option>0-1 Year</option>
                                <option>1-2 Years</option>
                                <option>2-4 Years</option>
                                <option>5+ Years</option>

                            </select>

                        </div>

                        <div class="mb-3">

                            <label asp-for="CurrentCity" class="form-label"></label>

                            <input asp-for="CurrentCity" class="form-control" />

                        </div>

                        <div class="mb-3">

                            <label class="form-label">Resume</label>

                            <input asp-for="ResumeFile"
                                   type="file"
                                   class="form-control" />

                        </div>

                        <button class="btn btn-success w-100">

                            Submit Application

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}